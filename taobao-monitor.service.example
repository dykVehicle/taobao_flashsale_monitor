[Unit]
Description=Taobao FlashSale Monitor
After=network.target

[Service]
Type=simple
User=dyk
WorkingDirectory=/home/dyk/ws/OneManCompany/taobao_flashsale_monitor
Environment=HEADLESS=true
# 通知配置（取消注释并填入实际值）
# Environment=SERVERCHAN_KEY=xxx
# Environment=PUSHPLUS_TOKEN=xxx
# Environment=WECOM_CORPID=xxx
# Environment=WECOM_CORPSECRET=xxx
# Environment=WECOM_AGENTID=xxx
# Environment=WECOM_TOUSER=@all
# wxauto 微信消息（Windows 机器运行 wxauto HTTP API）
# Environment=WCF_URL=http://192.168.1.7:9999
# Environment=WCF_RECEIVERS=联系人昵称或群名
ExecStart=/home/dyk/ws/OneManCompany/taobao_flashsale_monitor/venv/bin/python server_monitor.py --interval 30 --workers 5 --shop-list doc/门店列表_v2.xlsx
Restart=always
RestartSec=60

[Install]
WantedBy=multi-user.target
